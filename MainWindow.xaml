<Window x:Class="PDF_umbenenen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tesla Auftragsbearbeitung &amp; Druck" Height="760" Width="980"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource AppBackground}"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewDragEnter="Window_PreviewDragEnter"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <!-- Button-Basis -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground"             Value="{DynamicResource TextOnAccent}"/>
            <Setter Property="Background"             Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="Padding"                Value="16,7"/>
            <Setter Property="FontSize"               Value="13"/>
            <Setter Property="FontWeight"             Value="SemiBold"/>
            <Setter Property="Cursor"                 Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger-Button (Abbrechen) -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ghost-Button (Browse) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground"      Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding"         Value="12,5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ProgressBar -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height"     Value="10"/>
            <Setter Property="Background" Value="{DynamicResource ProgressTrack}"/>
            <Setter Property="Foreground" Value="{DynamicResource ProgressFill}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="5" Background="{TemplateBinding Background}">
                            <Border x:Name="PART_Indicator" CornerRadius="5"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid AllowDrop="True"
          DragEnter="Window_DragEnter"
          DragOver="Window_DragOver"
          Drop="Window_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>   <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Menüleiste -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══ -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- PDF-Icon -->
                    <Border Width="34" Height="34" CornerRadius="8"
                            Background="#E53935" Margin="0,0,12,0">
                        <TextBlock Text="PDF" Foreground="White" FontWeight="Bold"
                                   FontSize="11" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tesla Auftragsbearbeitung &amp; Druck"
                                   Foreground="{DynamicResource HeaderForeground}"
                                   FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Sortieren, Wasserzeichen, Zusammenfügen, Vorschau und Drucken"
                                   Foreground="{DynamicResource HeaderForeground}"
                                   FontSize="11" Opacity="0.7"/>
                        <TextBlock x:Name="AppVersionTextBlock"
                                   Foreground="{DynamicResource HeaderForeground}"
                                   FontSize="10" Opacity="0.65" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Hell/Dunkel-Schalter + Über-Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Über-Button -->
                    <Button x:Name="AboutHeaderButton"
                            Content="ℹ  Über"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource TextOnAccent}"
                            BorderThickness="0"
                            Padding="12,6"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="About_Click"
                            Margin="0,0,10,0"
                            Style="{StaticResource FlatButton}"/>

                    <Button x:Name="ManualHeaderButton"
                            Content="📘  Anleitung"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource TextOnAccent}"
                            BorderThickness="0"
                            Padding="12,6"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="OpenManual_Click"
                            Margin="0,0,16,0"
                            Style="{StaticResource FlatButton}"/>

                    <!-- Theme Toggle -->
                    <StackPanel Orientation="Horizontal" Cursor="Hand"
                                MouseLeftButtonUp="ThemeToggle_Click">
                        <TextBlock x:Name="ThemeIcon" Text="🌙" FontSize="18"
                                   Foreground="{DynamicResource ThemeToggleFG}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ThemeLabel" Text="Dunkel"
                                   Foreground="{DynamicResource HeaderForeground}"
                                   FontSize="12" VerticalAlignment="Center" Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ MENÜLEISTE ══ -->
        <Menu Grid.Row="1" Padding="12,2">
            <MenuItem Header="KI-Assistent">
                <MenuItem x:Name="AiEnabledMenuItem"
                          Header="KI aktiv"
                          IsCheckable="True"
                          Checked="AiEnabledMenu_Changed"
                          Unchecked="AiEnabledMenu_Changed"/>
                <Separator/>
                <MenuItem Header="Chat öffnen" Click="AiOpenChat_Click" InputGestureText="Strg+K"/>
                <MenuItem Header="Vor Verarbeitung prüfen" Click="AiQualityCheck_Click"/>
                <Separator/>
                <MenuItem Header="Ollama-Einstellungen..." Click="AiSettingsMenu_Click"/>
                <MenuItem Header="Status prüfen" Click="AiRefreshStatus_Click"/>
            </MenuItem>
            <MenuItem Header="Wasserzeichen">
                <MenuItem Header="Einstellungen..." Click="WatermarkSettingsMenu_Click"/>
            </MenuItem>
        </Menu>

        <!-- ══ CONTENT ══ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      AllowDrop="True"
                      DragEnter="Window_DragEnter"
                      DragOver="Window_DragOver"
                      Drop="Window_Drop">
            <StackPanel Margin="28,22,28,22">

                <!-- KARTE: Drag & Drop Ablage -->
                <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource GroupBorder}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="22,18" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                Padding="24,18"
                                Background="{DynamicResource InputBackground}">
                            <StackPanel>
                                <TextBlock Text="📥 Dateien hier per Maus reinziehen"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="PDF-Dateien, ZIP-Datei(en) und eine Excel-Datei (.xlsx/.xls) einfach in dieses Fenster ziehen."
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="13"
                                           Margin="0,8,0,0"
                                           TextAlignment="Center"/>
                                <TextBlock Text="Die Daten werden automatisch in die feste Ablage kopiert und verarbeitet."
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="13"
                                           Margin="0,4,0,0"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="IncludeSubfoldersCheckBox" Grid.Row="2"
                                  Content="Unterordner einbeziehen"
                                  Margin="4,0,0,0"/>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auftragsnummer" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBox x:Name="OrderNumberTextBox" Grid.Column="1" MinHeight="34" Margin="12,0,0,0"
                                     Foreground="{DynamicResource TextPrimary}"
                                     Background="{DynamicResource InputBackground}"/>
                        </Grid>

                        <StackPanel Grid.Row="6" Visibility="Collapsed">
                            <TextBox x:Name="ExcelPathTextBox" MinHeight="34"/>
                            <TextBox x:Name="PdfFolderTextBox" MinHeight="34" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KARTE: Aktionen -->
                <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource GroupBorder}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="22,18" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="⚙  Verarbeitung"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11" FontWeight="SemiBold"/>
                        <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                                   Margin="0,22,0,-2"
                                   Fill="{DynamicResource SeparatorBrush}"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button x:Name="ProcessButton"
                                    Content="▶  Sortieren &amp; umbenennen"
                                    Style="{StaticResource FlatButton}"
                                    MinWidth="220" Height="38" Margin="0,0,12,0"
                                    Click="Process_Click"/>
                            <Button x:Name="CancelButton"
                                    Content="✕  Abbrechen"
                                    Style="{StaticResource DangerButton}"
                                    MinWidth="130" Height="38"
                                    IsEnabled="False"
                                    Click="Cancel_Click"/>
                            <Button x:Name="MergePrintButton"
                                    Content="👁  Zusammenfügen &amp; Vorschau"
                                    Style="{StaticResource GhostButton}"
                                    MinWidth="220" Height="38" Margin="12,0,0,0"
                                    Click="MergeAndPrint_Click"/>
                            <Button x:Name="DeleteProcessedButton"
                                    Content="🗑  Bearbeitete Aufträge löschen"
                                    Style="{StaticResource GhostButton}"
                                    MinWidth="240" Height="38" Margin="12,0,0,0"
                                    Click="DeleteProcessedOrders_Click"/>
                        </StackPanel>

                        <!-- Fortschritt -->
                        <Grid Grid.Row="4" x:Name="ProgressPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="BusyProgressBar"
                                         Minimum="0" Maximum="100" Value="0"
                                         Height="10" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProgressLabel" Grid.Column="1"
                                       Text="0 %" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- KARTE: Status -->
                <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource GroupBorder}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="22,18" Height="310">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📋  Statusmeldungen"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11" FontWeight="SemiBold"/>
                        <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                                   Margin="0,22,0,-2"
                                   Fill="{DynamicResource SeparatorBrush}"/>
                        <Border Grid.Row="2" CornerRadius="6"
                                Background="{DynamicResource StatusBackground}"
                                BorderBrush="{DynamicResource StatusBorder}"
                                BorderThickness="1">
                            <TextBox x:Name="StatusTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimary}"
                                     FontSize="12" FontFamily="Consolas"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     IsReadOnly="True"
                                     Padding="10,8"/>
                        </Border>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
