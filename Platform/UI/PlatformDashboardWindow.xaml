<Window x:Class="PDF_umbenenen.Platform.UI.PlatformDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DOK-V01 KI-Plattform" Height="720" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <Image Source="pack://application:,,,/Assets/AppLogo.png" Height="36" Stretch="Uniform"
                   HorizontalAlignment="Left" Margin="0,0,0,8"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Modulare Offline-KI-Plattform" FontSize="18" FontWeight="SemiBold"/>
        </StackPanel>

        <TabControl Grid.Row="1" x:Name="MainTabs">
            <TabItem Header="Dokumentvorschau">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="PreviewFileBox" Width="520" Margin="0,0,8,0"/>
                        <Button Content="Datei wählen" Click="BrowseFile_Click" Margin="0,0,8,0"/>
                        <Button Content="Analysieren" Click="Analyze_Click"/>
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="PreviewTextBox" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                </Grid>
            </TabItem>
            <TabItem Header="KI-Analyse">
                <TextBox x:Name="AnalysisBox" Margin="8" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            </TabItem>
            <TabItem Header="Entscheidung">
                <TextBox x:Name="DecisionBox" Margin="8" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            </TabItem>
            <TabItem Header="Confidence">
                <StackPanel Margin="12">
                    <TextBlock Text="Vertrauenswert" FontWeight="SemiBold"/>
                    <ProgressBar x:Name="ConfidenceBar" Height="24" Minimum="0" Maximum="100" Margin="0,8,0,8"/>
                    <TextBlock x:Name="ConfidenceLabel"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Lernmodus">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="LearnDocKeyBox" Margin="0,0,0,6"/>
                    <TextBox Grid.Row="1" x:Name="LearnFieldBox" Margin="0,0,0,6"/>
                    <TextBox Grid.Row="2" x:Name="LearnValueBox" Margin="0,0,0,6"/>
                    <Button Grid.Row="3" Content="Korrektur speichern" Click="SaveCorrection_Click" HorizontalAlignment="Left"/>
                </Grid>
            </TabItem>
            <TabItem Header="Statistik">
                <TextBox x:Name="StatsBox" Margin="8" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            </TabItem>
            <TabItem Header="Verlauf">
                <TextBox x:Name="HistoryBox" Margin="8" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            </TabItem>
            <TabItem Header="System">
                <TextBox x:Name="MonitorBox" Margin="8" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Aktualisieren" Click="Refresh_Click" Margin="0,0,8,0"/>
            <Button Content="Schließen" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
