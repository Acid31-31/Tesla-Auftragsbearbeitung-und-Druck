<Window x:Class="PDF_umbenenen.AiChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KI-Hilfe Chat"
        Height="620" Width="720"
        MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="KI-Hilfe Chat"
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="AiChatStatusTextBlock"
                       Text="Offline-Hilfe"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="12"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" CornerRadius="8"
                Background="{DynamicResource StatusBackground}"
                BorderBrush="{DynamicResource StatusBorder}"
                BorderThickness="1">
            <ScrollViewer x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          Padding="12,10">
                <TextBlock x:Name="AiChatHistoryTextBlock"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="13"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <TextBox x:Name="AiChatInputTextBox" Grid.Row="4"
                 MinHeight="38"
                 Foreground="{DynamicResource TextPrimary}"
                 Background="{DynamicResource InputBackground}"
                 BorderBrush="{DynamicResource InputBorder}"
                 Padding="10,8"
                 FontSize="13"
                 TextWrapping="Wrap"
                 AcceptsReturn="False"
                 KeyDown="AiChatInput_KeyDown"/>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Enter = Senden"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="11"
                       VerticalAlignment="Center"/>
            <Button x:Name="AiSendChatButton" Grid.Column="1"
                    Content="Senden"
                    MinWidth="100" Height="36" Margin="0,0,10,0"
                    Click="AiSendChat_Click"/>
            <Button Grid.Column="2"
                    Content="Schließen"
                    Style="{StaticResource DialogSecondaryButton}"
                    MinWidth="100" Height="36"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
