<Window x:Class="PDF_umbenenen.PdfPrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Druckvorschau"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <Style x:Key="PreviewButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PreviewButton}">
            <Setter Property="Background" Value="{DynamicResource TextSecondary}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Druckvorschau — Seiten prüfen, dann drucken."
                   FontSize="13"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource GroupBorder}"
                BorderThickness="1"
                Background="White"
                CornerRadius="6">
            <DocumentViewer x:Name="PrintDocumentViewer"
                            Background="White"/>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="PrintButton"
                        Content="Drucken"
                        Style="{StaticResource PreviewButton}"
                        IsEnabled="False"
                        Click="PrintButton_Click"/>
                <Button Content="Schließen"
                        Style="{StaticResource SecondaryButton}"
                        Click="Close_Click"
                        Margin="0"/>
            </StackPanel>
            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Lade Druckvorschau…"/>
        </DockPanel>
    </Grid>
</Window>
