<Window x:Class="PDF_umbenenen.CustomerSortPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sortier-Vorschau"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        ResizeMode="CanResize"
        ShowInTaskbar="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="HeaderTextBlock"
                   FontWeight="SemiBold"
                   FontSize="16"
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="2"
                   x:Name="PathsTextBlock"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="11"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Content="PDF-Ordner wählen…"
                    MinWidth="140"
                    Margin="0,0,10,0"
                    Click="PickPdfFolder_Click"/>
            <Button Content="Excel wählen…"
                    MinWidth="120"
                    Margin="0,0,10,0"
                    Click="PickExcel_Click"/>
            <Button Content="Bestell-PDF wählen…"
                    MinWidth="140"
                    Margin="0,0,10,0"
                    Click="PickOrderPdf_Click"/>
            <Button Content="Aus Ablage übernehmen"
                    MinWidth="150"
                    Click="UseWorkspace_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="6"
                   x:Name="StatusTextBlock"
                   Foreground="{DynamicResource AccentBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource GroupBorder}"
                    BorderThickness="1"
                    Background="{DynamicResource CardBackground}">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Sortierreihenfolge"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,8"/>
                    <ListBox x:Name="SortListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource TextPrimary}"
                             SelectionChanged="SortListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding ListTitle}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ListSubtitle}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource GroupBorder}"
                    BorderThickness="1"
                    Background="White">
                <Grid>
                    <ScrollViewer x:Name="PagesScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="White">
                        <StackPanel x:Name="PagesStack"
                                    Background="White"
                                    HorizontalAlignment="Center"/>
                    </ScrollViewer>
                    <TextBlock x:Name="HintTextBlock"
                               Text="PDF-Vorschau wird geladen…"
                               Foreground="#666"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Aktualisieren"
                    MinWidth="110"
                    Margin="0,0,10,0"
                    Click="Refresh_Click"/>
            <Button Content="Schließen"
                    MinWidth="110"
                    Style="{StaticResource DialogSecondaryButton}"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
