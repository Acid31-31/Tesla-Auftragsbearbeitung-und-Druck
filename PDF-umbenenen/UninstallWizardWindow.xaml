<Window x:Class="PDF_umbenenen.UninstallWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DOK-V01 Deinstallation"
        Height="520" Width="680"
        MinHeight="480" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="WizardButton" TargetType="Button">
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GroupBorder}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="WizardDangerButton" TargetType="Button" BasedOn="{StaticResource WizardButton}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="WizardCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="WizardSecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource GroupBorder}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="pack://application:,,,/Assets/AppLogo.png"
                       Height="48" Margin="0,0,16,0" Stretch="Uniform"
                       SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Deinstallation" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource HeaderForeground}"/>
                    <TextBlock x:Name="StepTitleTextBlock" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="24,16" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource GroupBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid>
                <StackPanel x:Name="ConfirmPanel" Visibility="Visible">
                    <TextBlock Text="Möchten Sie DOK-V01 deinstallieren?" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" Margin="0,0,0,12"
                               Text="Folgende Komponenten werden entfernt:"/>
                    <TextBlock Text="• Programmdateien im Installationsordner" Margin="12,0,0,4"/>
                    <TextBlock Text="• Desktop-Verknüpfung DOK-V01.lnk" Margin="12,0,0,12"/>
                    <CheckBox x:Name="RemoveUserDataCheckBox" Style="{StaticResource WizardCheckBox}"
                              Content="Installationsordner vollständig löschen (inkl. Ablage und Einstellungen)"/>
                    <TextBlock x:Name="NotInstalledTextBlock" Margin="0,16,0,0" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" Visibility="Collapsed"
                               Text="Es wurde keine Installation gefunden."/>
                </StackPanel>

                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Deinstallation läuft…" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <ProgressBar Height="8" IsIndeterminate="True" Margin="40,0"
                                 Foreground="{DynamicResource DangerBrush}" Background="{DynamicResource ProgressTrack}"/>
                    <TextBlock x:Name="ProgressStatusTextBlock" Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource WizardSecondaryText}"/>
                </StackPanel>

                <StackPanel x:Name="FinishPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Deinstallation abgeschlossen" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock x:Name="FinishMessageTextBlock" TextWrapping="Wrap" FontSize="14" LineHeight="22" HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource GroupBorder}" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel LastChildFill="False">
                <Button x:Name="CancelButton" Content="Abbrechen" Click="CancelButton_Click"
                        Style="{StaticResource WizardButton}" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="UninstallButton" Content="Deinstallieren" Click="UninstallButton_Click"
                            Style="{StaticResource WizardDangerButton}"/>
                    <Button x:Name="CloseButton" Content="Schließen" Click="CloseButton_Click"
                            Style="{StaticResource WizardButton}" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
