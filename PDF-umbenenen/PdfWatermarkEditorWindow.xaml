<Window x:Class="PDF_umbenenen.PdfWatermarkEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wasserzeichen korrigieren"
        Height="820" Width="1100"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <Style x:Key="EditorButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource EditorButton}">
            <Setter Property="Background" Value="{DynamicResource TextSecondary}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Korrekturen werden sofort gelernt. Beim Wechsel zur nächsten Zeichnung übernimmt die App die Position automatisch."
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,10"/>

        <DockPanel x:Name="NavigationPanel" Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="◀ Zurück" Style="{StaticResource SecondaryButton}" Click="PreviousItem_Click"/>
                <Button Content="Weiter ▶" Style="{StaticResource SecondaryButton}" Click="NextItem_Click"/>
            </StackPanel>
            <TextBlock x:Name="FileInfoTextBlock"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold"/>
        </DockPanel>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource GroupBorder}"
                BorderThickness="1"
                Background="White"
                CornerRadius="6">
            <ScrollViewer x:Name="PreviewScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="White">
                <Canvas x:Name="PreviewCanvas"
                        Background="White"
                        Width="800"
                        Height="1100">
                    <Image x:Name="PreviewImage"
                           Stretch="None"
                           Canvas.Left="0"
                           Canvas.Top="0"/>
                </Canvas>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,8">
            <TextBlock Text="Material / Stärke (ausgewähltes Wasserzeichen)"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="MaterialTextBox"
                     FontSize="14"
                     Padding="8,6"
                     TextChanged="MaterialTextBox_TextChanged"/>
        </StackPanel>

        <DockPanel Grid.Row="4">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Speichern" Style="{StaticResource EditorButton}" Click="SaveCurrent_Click"/>
                <Button x:Name="RemergeButton"
                        Content="Gesamt-PDF speichern &amp; öffnen"
                        Style="{StaticResource EditorButton}"
                        Click="SaveAllAndRemerge_Click"/>
                <Button Content="Schließen" Style="{StaticResource SecondaryButton}" Click="Close_Click" Margin="0"/>
            </StackPanel>
            <TextBlock x:Name="HintTextBlock"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Tipp: Wasserzeichen mit der Maus ziehen. Material-Feld bearbeiten und speichern."/>
        </DockPanel>
    </Grid>
</Window>
