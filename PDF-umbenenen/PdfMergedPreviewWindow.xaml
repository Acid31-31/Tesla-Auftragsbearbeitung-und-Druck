<Window x:Class="PDF_umbenenen.PdfMergedPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gesamt-PDF Vorschau"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <Style x:Key="PreviewButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PreviewButton}">
            <Setter Property="Background" Value="{DynamicResource TextSecondary}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Gesamt-PDF — defekte Zeichnung ersetzen: korrekte PDF auf die Seite ziehen. Oder „Materialstärke ändern“."
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,8"/>

        <TextBlock x:Name="PageInfoTextBlock"
                   Grid.Row="1"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <Grid Grid.Row="2">
            <Border BorderBrush="{DynamicResource GroupBorder}"
                    BorderThickness="1"
                    Background="White"
                    CornerRadius="6">
                <ScrollViewer x:Name="AllPagesScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Background="White"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly"
                              ScrollChanged="AllPagesScroll_ScrollChanged"
                              SizeChanged="AllPagesScroll_SizeChanged">
                    <StackPanel x:Name="PagesStack"
                                Background="White"
                                HorizontalAlignment="Center"/>
                </ScrollViewer>
            </Border>

            <Border x:Name="EditViewBorder"
                    BorderBrush="{DynamicResource GroupBorder}"
                    BorderThickness="1"
                    Background="White"
                    CornerRadius="6"
                    Visibility="Collapsed">
                <ScrollViewer x:Name="EditScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="White"
                              SizeChanged="EditScrollViewer_SizeChanged">
                    <Viewbox x:Name="EditViewbox"
                             Stretch="Uniform"
                             StretchDirection="DownOnly"
                             HorizontalAlignment="Center">
                        <Canvas x:Name="PreviewCanvas"
                                Background="White"
                                Width="800"
                                Height="1100">
                            <Image x:Name="PreviewImage"
                                   Stretch="None"
                                   Canvas.Left="0"
                                   Canvas.Top="0"/>
                        </Canvas>
                    </Viewbox>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel x:Name="EditPanel"
                    Grid.Row="3"
                    Margin="0,10,0,6"
                    Visibility="Collapsed">
            <TextBlock Text="Materialstärke ändern"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="MaterialTextBox"
                     FontSize="14"
                     Padding="8,6"
                     TextChanged="MaterialTextBox_TextChanged"/>
            <TextBlock Text="Nur die Materialstärke im Feld ändern, dann Speichern. BG und alle anderen Wasserzeichen bleiben fest."
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <DockPanel Grid.Row="4">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="ChangeDateButton"
                        Content="Termin ändern"
                        Style="{StaticResource PreviewButton}"
                        Click="ChangeDateButton_Click"/>
                <Button x:Name="CorrectButton"
                        Content="Materialstärke ändern"
                        Style="{StaticResource PreviewButton}"
                        Click="CorrectButton_Click"/>
                <Button x:Name="SaveButton"
                        Content="Speichern"
                        Style="{StaticResource PreviewButton}"
                        Visibility="Collapsed"
                        Click="SaveButton_Click"/>
                <Button x:Name="CancelEditButton"
                        Content="Abbrechen"
                        Style="{StaticResource SecondaryButton}"
                        Visibility="Collapsed"
                        Click="CancelEditButton_Click"/>
                <Button x:Name="OpenPdfButton"
                        Content="Gesamt-PDF öffnen"
                        Style="{StaticResource PreviewButton}"
                        Click="OpenPdfButton_Click"/>
                <Button Content="Schließen"
                        Style="{StaticResource SecondaryButton}"
                        Click="Close_Click"
                        Margin="0"/>
            </StackPanel>
            <TextBlock x:Name="HintTextBlock"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Lade Vorschau…"/>
        </DockPanel>
    </Grid>
</Window>
