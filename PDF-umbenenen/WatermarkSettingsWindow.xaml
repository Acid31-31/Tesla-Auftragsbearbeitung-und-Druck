<Window x:Class="PDF_umbenenen.WatermarkSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wasserzeichen-Einstellungen"
        Height="780" Width="580"
        MinHeight="560" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Gilt für „Sortieren &amp; umbenennen“. Änderungen werden gespeichert."
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="12"
                   TextWrapping="Wrap"/>

        <CheckBox x:Name="WatermarksEnabledCheckBox" Grid.Row="2"
                  Content="Wasserzeichen aktivieren"
                  Foreground="{DynamicResource TextPrimary}"
                  FontSize="13"/>

        <TextBlock Grid.Row="4"
                   Text="Intelligente Platzierung ist immer aktiv (PDF-Analyse)."
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="12"
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="6"
                   Text="Material &amp; Baugruppe (feste Position)"
                   Foreground="{DynamicResource TextPrimary}"
                   FontSize="13"
                   FontWeight="SemiBold"/>

        <CheckBox x:Name="ExtractMaterialTypeCheckBox" Grid.Row="8"
                  Content="Werkstoff aus Schriftfeld erkennen"
                  Foreground="{DynamicResource TextPrimary}"
                  FontSize="13"/>

        <CheckBox x:Name="ExtractMaterialThicknessCheckBox" Grid.Row="10"
                  Content="Materialstärke aus Schriftfeld erkennen"
                  Foreground="{DynamicResource TextPrimary}"
                  FontSize="13"/>

        <TextBlock Grid.Row="12"
                   Text="Position fest: unten links (gleiche Höhe wie Seitenzahl)."
                   Margin="24,0,0,0"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="11"
                   TextWrapping="Wrap"/>

        <CheckBox x:Name="BgWatermarkEnabledCheckBox" Grid.Row="14"
                  Content="Baugruppen-Wasserzeichen"
                  Foreground="{DynamicResource TextPrimary}"
                  FontSize="13"/>

        <TextBlock Grid.Row="16"
                   Text="Position fest: rechts senkrecht (−90°), Schrift wie Seitenzahl."
                   Margin="24,0,0,0"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="11"
                   TextWrapping="Wrap"/>

        <CheckBox x:Name="ExtractPowderCoatingCheckBox" Grid.Row="18"
                  Content="Pulverbeschichtung (RAL) aus Oberflächenbehandlung"
                  Foreground="{DynamicResource TextPrimary}"
                  FontSize="13"/>

        <CheckBox x:Name="PowderCoatingShowRalNumberCheckBox" Grid.Row="20" Margin="24,0,0,0"
                  Content="RAL mit Farbnummer (z. B. RAL 9003) – sonst nur „RAL“"
                  Foreground="{DynamicResource TextPrimary}"
                  FontSize="12"/>

        <CheckBox x:Name="ExtractAnodizingCheckBox" Grid.Row="22"
                  Content="Eloxierung aus Oberflächenbehandlung (Wasserzeichen „ELOX“)"
                  Foreground="{DynamicResource TextPrimary}"
                  FontSize="13"/>

        <TextBlock Grid.Row="24"
                   Text="Wenn im Schriftfeld „Oberflächenbehandlung“ ein Eintrag steht, erscheint RAL bzw. ELOX fest unten rechts."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="11"
                   VerticalAlignment="Top"
                   Margin="0,4,0,0"/>

        <StackPanel Grid.Row="25" Margin="0,14,0,0">
            <TextBlock Text="Oben (fest)"
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <TextBlock Text="Links: Lieferort · Mitte: Auftragsnummer · Rechts: LT/FT"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="11"
                       Margin="0,0,0,0"/>

            <CheckBox x:Name="MirrorBottomToTopBandCheckBox"
                      Content="Unten wie oben ausrichten (pro Zeichnung, maßstabsunabhängig)"
                      Foreground="{DynamicResource TextPrimary}"
                      FontSize="13"
                      Margin="0,16,0,0"
                      IsChecked="True"/>
            <TextBlock Text="Misst auf jeder Seite den oberen Rand und setzt Seite/RAL unten mit demselben Abstand. Kein fester mm-Wert – funktioniert bei jedem Maßstab. Danach neu sortieren."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="11"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="26" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" Width="100" Height="32" Margin="0,0,10,0"
                    Style="{StaticResource DialogSecondaryButton}"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Speichern" Width="100" Height="32"
                    IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
