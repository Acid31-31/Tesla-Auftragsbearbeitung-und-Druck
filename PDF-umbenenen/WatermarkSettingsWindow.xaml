<Window x:Class="PDF_umbenenen.WatermarkSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wasserzeichen-Einstellungen"
        Height="360" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Gilt für „Sortieren &amp; umbenennen“. Änderungen werden gespeichert."
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="12"
                   TextWrapping="Wrap"/>

        <CheckBox x:Name="WatermarksEnabledCheckBox" Grid.Row="2"
                  Content="Wasserzeichen aktivieren"
                  Foreground="{DynamicResource TextPrimary}"
                  FontSize="13"/>

        <CheckBox x:Name="SmartPlacementCheckBox" Grid.Row="4"
                  Content="Intelligente Platzierung (PDF-Analyse)"
                  Foreground="{DynamicResource TextPrimary}"
                  FontSize="13"/>

        <CheckBox x:Name="ExtractMaterialTypeCheckBox" Grid.Row="6"
                  Content="Werkstoff aus Schriftfeld erkennen"
                  Foreground="{DynamicResource TextPrimary}"
                  FontSize="13"/>

        <CheckBox x:Name="ExtractMaterialThicknessCheckBox" Grid.Row="8"
                  Content="Materialstärke aus Schriftfeld erkennen"
                  Foreground="{DynamicResource TextPrimary}"
                  FontSize="13"/>

        <TextBlock Grid.Row="9"
                   Text="Regeln bei intelligenter Platzierung: Stückzahl · Lieferort · BG · Auftragsnr. · optional Material/Werkstoff unten links."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="11"
                   VerticalAlignment="Top"
                   Margin="0,8,0,0"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abbrechen" Width="100" Height="32" Margin="0,0,10,0"
                    Style="{StaticResource DialogSecondaryButton}"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Speichern" Width="100" Height="32"
                    IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
