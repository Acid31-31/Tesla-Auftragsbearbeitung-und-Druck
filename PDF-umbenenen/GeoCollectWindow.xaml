<Window x:Class="PDF_umbenenen.GeoCollectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GEO-Dateien"
        Height="640" Width="1040"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        ResizeMode="CanResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="GeoCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Found}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="GEO-Dateien zum Auftrag" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="SummaryTextBlock"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="TargetFolderTextBlock"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <DockPanel Grid.Row="2" LastChildFill="False">
            <TextBlock Text="Materialstärke:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ThicknessFilterCombo"
                      Width="140" Height="30"
                      SelectionChanged="ThicknessFilter_Changed"/>
            <Button Content="Alle auswählen" Height="30" Margin="16,0,0,0" Padding="12,0"
                    Style="{StaticResource DialogSecondaryButton}"
                    Click="SelectAllVisible_Click"/>
            <Button Content="Auswahl im Explorer" Height="30" Margin="8,0,0,0" Padding="12,0"
                    Style="{StaticResource DialogSecondaryButton}"
                    Click="OpenTargetFolder_Click"
                    ToolTip="Zielordner öffnen"/>
            <TextBlock DockPanel.Dock="Right"
                       Text="Strg+A · Mehrfachauswahl ziehen → Explorer · Doppelklick öffnen"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
        </DockPanel>

        <ListView x:Name="GeoListView"
                  Grid.Row="4"
                  SelectionMode="Extended"
                  MouseDoubleClick="GeoListView_MouseDoubleClick"
                  PreviewMouseLeftButtonDown="GeoListView_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="GeoListView_PreviewMouseMove"
                  PreviewMouseLeftButtonUp="GeoListView_PreviewMouseLeftButtonUp"
                  BorderBrush="{DynamicResource GroupBorder}"
                  Background="{DynamicResource CardBackground}"
                  Foreground="{DynamicResource TextPrimary}">
            <ListView.InputBindings>
                <KeyBinding Key="A" Modifiers="Control" Command="ApplicationCommands.SelectAll"/>
            </ListView.InputBindings>
            <ListView.CommandBindings>
                <CommandBinding Command="ApplicationCommands.SelectAll" Executed="SelectAll_Executed"/>
            </ListView.CommandBindings>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="bd"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource SeparatorBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="4,6"
                                        SnapsToDevicePixels="True">
                                    <GridViewRowPresenter VerticalAlignment="Center"
                                                          Content="{TemplateBinding Content}"
                                                          Columns="{Binding Path=View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource InputBackground}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Status" Width="190">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource GeoCellText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Zeichnung" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DrawingNumber}" Style="{StaticResource GeoCellText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Rev" Width="55">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DrawingRevision}" Style="{StaticResource GeoCellText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="BG" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BgNumbersText}" Style="{StaticResource GeoCellText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Stärke" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ThicknessMm}" Style="{StaticResource GeoCellText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Menge" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RequestedQuantity}" Style="{StaticResource GeoCellText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Datei" Width="260">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}" Style="{StaticResource GeoCellText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="GEO-Einstellungen…" Height="32" Margin="0,0,8,0" Padding="12,0"
                    Style="{StaticResource DialogSecondaryButton}"
                    Click="OpenSettings_Click"/>
            <Button Content="Schließen" Width="100" Height="32"
                    Style="{StaticResource DialogSecondaryButton}"
                    IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
