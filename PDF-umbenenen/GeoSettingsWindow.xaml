<Window x:Class="PDF_umbenenen.GeoSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GEO-Suche"
        Height="520" Width="560"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="GEO-Suche" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Hauptordner je Material (z. B. Stahl, VA). Darunter erwartet die App mm-Ordner (1mm, 3mm, …) und sucht gezielt nach der erkannten Materialstärke der Zeichnung – nicht den ganzen Baum."
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="FoldersListBox"
                     Grid.Column="0"
                     SelectionMode="Extended"
                     BorderBrush="{DynamicResource GroupBorder}"
                     Background="{DynamicResource CardBackground}"
                     Foreground="{DynamicResource TextPrimary}"/>

            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <Button Content="Hinzufügen…" Width="120" Height="32" Margin="0,0,0,8"
                        Style="{StaticResource DialogSecondaryButton}"
                        Click="AddFolder_Click"/>
                <Button Content="Entfernen" Width="120" Height="32"
                        Style="{StaticResource DialogSecondaryButton}"
                        Click="RemoveFolder_Click"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="4" Text="Zielordner für Kopien (optional)"
                   FontWeight="SemiBold" FontSize="13"/>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TargetBaseTextBox"
                     Height="32" VerticalContentAlignment="Center"
                     ToolTip="Leer = Ablage\GEO\&lt;Auftrag&gt;"/>
            <Button Grid.Column="2" Content="…" Width="40" Height="32"
                    Style="{StaticResource DialogSecondaryButton}"
                    Click="BrowseTarget_Click"/>
        </Grid>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Speichern" Width="100" Height="32" Margin="0,0,8,0"
                    Click="Save_Click"/>
            <Button Content="Abbrechen" Width="100" Height="32"
                    Style="{StaticResource DialogSecondaryButton}"
                    IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
