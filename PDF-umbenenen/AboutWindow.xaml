<Window x:Class="PDF_umbenenen.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Über DOK-V01"
        Height="520" Width="650"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SimpleButton" TargetType="Button">
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Image Source="pack://application:,,,/Assets/AppLogo.png"
                           Width="56" Height="56" Margin="0,0,16,0"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="DOK-V01"
                               VerticalAlignment="Center"
                               FontSize="24" FontWeight="Bold"
                               Foreground="#333333"/>
                </StackPanel>

                <!-- Version Info -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock x:Name="VersionTextBlock"
                               Text="Version 1.1 R03 (Enterprise Edition)" 
                               FontSize="14" 
                               Foreground="#333333"
                               Margin="0,0,0,5"/>

                    <TextBlock x:Name="BuildDateTextBlock"
                               Text="Build Date: 17. Juni 2026" 
                               FontSize="12" 
                               Foreground="#666666"
                               Margin="0,0,0,10"/>
                </StackPanel>

                <!-- Separator -->
                <Border Height="1" Background="#CCCCCC" Margin="0,5,0,10"/>

                <!-- Description -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Beschreibung:" 
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#007BFF"
                               Margin="0,0,0,8"/>

                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="#333333"
                               Margin="0,0,0,15">
                        <Run Text="Professionelle Lösung für PDF-Auftragsbearbeitung, Sortierung, Analyse, Wasserzeichen-Verwaltung und automatisierte Dokumentenverarbeitung mit Multi-Page Watermark-Unterstützung, automatischer Datenintegration und Qualitätssicherung."/>
                    </TextBlock>
                </StackPanel>

                <!-- License Section -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Lizenz:" 
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#007BFF"
                               Margin="0,0,0,8"/>

                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="#333333"
                               Margin="0,0,0,15">
                        <Run Text="Proprietäre Lizenz - Copyright © 2026 Alexander Hölzer"/>
                        <LineBreak/>
                        <LineBreak/>
                        <Run Text="Keine Weitergabe, kein Verkauf und keine Unterlizenzierung ohne vorherige schriftliche Genehmigung. Siehe LICENSE.txt für alle Bedingungen."/>
                    </TextBlock>
                </StackPanel>

                <!-- Dependencies -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Abhängigkeiten:" 
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#007BFF"
                               Margin="0,0,0,8"/>

                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="#333333"
                               Margin="0,0,0,15">
                        <Run Text="• .NET Framework 4.8"/>
                        <LineBreak/>
                        <Run Text="• iTextSharp 5.5.13.5"/>
                        <LineBreak/>
                        <Run Text="• BouncyCastle.Cryptography 2.6.2"/>
                        <LineBreak/>
                        <Run Text="• Windows Presentation Foundation (WPF)"/>
                    </TextBlock>
                </StackPanel>

                <!-- System Requirements -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Systemanforderungen:" 
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#007BFF"
                               Margin="0,0,0,8"/>

                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="#333333"
                               Margin="0,0,0,15">
                        <Run Text="• Windows 7 SP1 oder höher (empfohlen: Windows 10/11)"/>
                        <LineBreak/>
                        <Run Text="• .NET Framework 4.8 Runtime"/>
                        <LineBreak/>
                        <Run Text="• 50 MB verfügbarer Festplattenspeicher"/>
                        <LineBreak/>
                        <Run Text="• 100 MB RAM"/>
                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Close Button Panel -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="30,20,30,20" Orientation="Horizontal">
            <Button Content="Lizenz anzeigen" 
                    Click="ShowLicense_Click"
                    Style="{StaticResource SimpleButton}"
                    Padding="12,8"
                    Margin="0,0,10,0"/>
            <Button Content="Schließen" 
                    Click="Close_Click"
                    Style="{StaticResource SimpleButton}"/>
        </StackPanel>
    </Grid>
</Window>
