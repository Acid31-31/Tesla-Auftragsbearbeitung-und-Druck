<Window x:Class="PDF_umbenenen.AiSettingsWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="KI-Einstellungen"

        Height="380" Width="520"

        WindowStartupLocation="CenterOwner"

        Background="{DynamicResource AppBackground}"

        ResizeMode="NoResize"

        ShowInTaskbar="False">



    <Grid Margin="22">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="16"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="10"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="10"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="14"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <TextBlock Grid.Row="0"

                   Text="Offline-KI für Chat und Hilfe (Ollama, nur localhost). Materialstärke läuft immer automatisch."

                   Foreground="{DynamicResource TextSecondary}"

                   FontSize="12"

                   TextWrapping="Wrap"/>



        <CheckBox x:Name="AiEnabledCheckBox" Grid.Row="2"

                  Content="KI-Chat aktiv"

                  Foreground="{DynamicResource TextPrimary}"

                  FontSize="13"/>



        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="110"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <TextBlock Text="Ollama-URL" VerticalAlignment="Center"

                       Foreground="{DynamicResource TextPrimary}" FontSize="13"/>

            <TextBox x:Name="OllamaUrlTextBox" Grid.Column="1" MinHeight="32" Margin="10,0,0,0"/>

        </Grid>



        <Grid Grid.Row="6">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="110"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <TextBlock Text="Chat-Modell" VerticalAlignment="Center"

                       Foreground="{DynamicResource TextPrimary}" FontSize="13"/>

            <TextBox x:Name="AiModelNameTextBox" Grid.Column="1" MinHeight="32" Margin="10,0,0,0"/>

        </Grid>



        <TextBlock Grid.Row="8"

                   Text="Materialstärke: automatisch per Regeln und llava:7b (lokal), ohne Einstellungen."

                   TextWrapping="Wrap"

                   Foreground="{DynamicResource TextSecondary}"

                   FontSize="12"/>



        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">

            <Button Content="Abbrechen" Width="100" Height="32" Margin="0,0,10,0"

                    Style="{StaticResource DialogSecondaryButton}"

                    IsCancel="True" Click="Cancel_Click"/>

            <Button Content="Speichern" Width="100" Height="32"

                    IsDefault="True" Click="Save_Click"/>

        </StackPanel>

    </Grid>

</Window>

