<Window x:Class="PDF_umbenenen.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KI-Plattform (offline)"
        Height="520" Width="640"
        MinHeight="460" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Lokale Offline-Module: Tesseract-OCR, PDF-Layout, Regel-Engine. Kein Ollama, kein Internet."
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="12"
                   TextWrapping="Wrap"/>

        <CheckBox x:Name="LocalVisionCheckBox" Grid.Row="2"
                  Content="Lokale Zeichnungsanalyse (Layout + OCR + Regeln)"
                  Foreground="{DynamicResource TextPrimary}"
                  FontSize="13"/>

        <CheckBox x:Name="LocalOcrCheckBox" Grid.Row="4"
                  Content="Tesseract-OCR für Schriftfelder ohne Textlayer"
                  Foreground="{DynamicResource TextPrimary}"
                  FontSize="13"/>

        <CheckBox x:Name="AiEnabledCheckBox" Grid.Row="6"
                  Content="KI-Chat (Regel-Assistent, offline)"
                  Foreground="{DynamicResource TextPrimary}"
                  FontSize="13"/>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Tesseract" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
            <TextBox x:Name="TesseractPathTextBox" Grid.Column="1" MinHeight="32" Margin="10,0,8,0"
                     ToolTip="Optional: Pfad zu tesseract.exe — leer = automatisch suchen"/>
            <Button x:Name="InstallTesseractButton" Grid.Column="2" Content="Installieren…"
                    MinHeight="32" Padding="12,0" Click="InstallTesseract_Click"
                    ToolTip="Tesseract OCR herunterladen und installieren (offline, kein Ollama)"/>
        </Grid>

        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="OCR-Sprachen" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
            <TextBox x:Name="OcrLanguagesTextBox" Grid.Column="1" MinHeight="32" Margin="10,0,0,0"
                     ToolTip="z. B. deu+eng"/>
        </Grid>

        <TextBlock Grid.Row="12"
                   x:Name="StatusHintTextBlock"
                   Text="Tesseract: wird geprüft…"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="12"/>

        <TextBlock Grid.Row="13"
                   Text="Hinweis: Die KI läuft komplett offline (Regeln + PDF-Layout). Für OCR fehlt nur Tesseract — ein separates Programm, kein Ollama und kein Internet."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="11"
                   Margin="0,0,0,4"/>

        <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Abbrechen" Width="100" Height="32" Margin="0,0,10,0"
                    Style="{StaticResource DialogSecondaryButton}"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Speichern" Width="100" Height="32"
                    IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
