<Window x:Class="PDF_umbenenen.DemoExpiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Demoversion abgelaufen"
        Height="460" Width="580"
        MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="SimpleButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource SimpleButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <Image Source="pack://application:,,,/Assets/AppLogo.png" Height="40" Stretch="Uniform"
                   HorizontalAlignment="Left" Margin="0,0,0,12"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Demoversion abgelaufen"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource DangerBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock x:Name="MessageTextBlock"
                       TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="22"/>
            <TextBlock x:Name="DetailTextBlock"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,10,0,0"/>

            <TextBlock Text="Vollversion freischalten"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="0,16,0,6"/>
            <TextBlock x:Name="MachineCodeTextBlock"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LicenseKeyTextBox"
                         Height="34"
                         Padding="10,6"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         ToolTip="Lizenzschlüssel vom Anbieter"/>
                <Button Grid.Column="2"
                        Content="Freischalten"
                        Click="Activate_Click"
                        Style="{StaticResource SimpleButton}"
                        MinWidth="120"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Auf Update prüfen"
                    Click="CheckUpdate_Click"
                    Style="{StaticResource OutlineButton}"
                    Margin="0,0,10,0"/>
            <Button Content="Schließen"
                    Click="Close_Click"
                    Style="{StaticResource OutlineButton}"/>
        </StackPanel>
    </Grid>
</Window>
