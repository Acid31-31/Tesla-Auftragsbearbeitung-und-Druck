<Window x:Class="PDF_umbenenen.UpdateApplyProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DOK-V01 wird aktualisiert"
        Height="280" Width="480"
        MinHeight="240" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Image Source="pack://application:,,,/Assets/AppLogo.png" Height="32" Stretch="Uniform"
                   HorizontalAlignment="Left" Margin="0,0,0,8"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Update wird installiert…"
                       FontSize="16" FontWeight="SemiBold"/>
        </StackPanel>

        <ProgressBar x:Name="InstallProgressBar"
                     Grid.Row="1"
                     Height="10"
                     Minimum="0"
                     Maximum="100"
                     Value="0"
                     Foreground="{DynamicResource ProgressFill}"
                     Background="{DynamicResource ProgressTrack}"/>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusTextBlock"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="PercentTextBlock"
                       HorizontalAlignment="Right"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ProgressFill}"
                       VerticalAlignment="Center"/>
        </Grid>

        <Button x:Name="CancelButton"
                Grid.Row="3"
                Content="Abbrechen – später"
                MinWidth="160"
                Height="34"
                Padding="12,0"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Click="CancelButton_Click"/>
    </Grid>
</Window>
