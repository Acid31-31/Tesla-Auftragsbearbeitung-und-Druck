<Window x:Class="PDF_umbenenen.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update verfügbar"
        Height="520" Width="580"
        MinHeight="420" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <Image Source="pack://application:,,,/Assets/AppLogo.png" Height="36" Stretch="Uniform"
                   HorizontalAlignment="Left" Margin="0,0,0,12"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Eine neuere Version ist auf GitHub verfügbar."
                       FontSize="16" FontWeight="SemiBold"/>
        </StackPanel>

        <Border Grid.Row="1"
                x:Name="NotesBorder"
                BorderBrush="{DynamicResource GroupBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Background="{DynamicResource CardBackground}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="VersionTextBlock" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="NotesTextBlock" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel x:Name="ProgressPanel"
                    Grid.Row="2"
                    Margin="0,12,0,8"
                    Visibility="Collapsed">
            <ProgressBar x:Name="UpdateProgressBar"
                         Height="10"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Foreground="{DynamicResource ProgressFill}"
                         Background="{DynamicResource ProgressTrack}"/>
            <Grid Margin="0,8,0,0">
                <TextBlock x:Name="StatusTextBlock"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="PercentTextBlock"
                           HorizontalAlignment="Right"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ProgressFill}"
                           VerticalAlignment="Center"
                           Text="0 %"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="UpdateButton"
                    Content="Jetzt aktualisieren"
                    Width="160"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="UpdateButton_Click"/>
            <Button x:Name="LaterButton"
                    Content="Später"
                    Width="100"
                    Height="36"
                    Click="LaterButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
