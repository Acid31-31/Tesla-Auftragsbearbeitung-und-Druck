<Window x:Class="PDF_umbenenen.WatermarkPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wasserzeichen korrigieren"
        Height="520" Width="640"
        MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Zeichnung auswählen, bei der Wasserzeichen oder Material falsch sind:"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <ListBox x:Name="FilesListBox"
                 Grid.Row="1"
                 MouseDoubleClick="FilesListBox_MouseDoubleClick"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Korrigieren"
                    Width="120"
                    Margin="0,0,8,0"
                    Padding="12,8"
                    Click="Ok_Click"/>
            <Button Content="Abbrechen"
                    Width="100"
                    Padding="12,8"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
