<Window x:Class="PDF_umbenenen.NewCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neuen Kunden anlegen"
        Height="560" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Beispiel-Dateien des Kunden hierher ziehen (Excel, Bestell-PDF, Zeichnungs-PDFs). Die KI erkennt Zeichnungsnummern, Menge und Workflow."
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="12"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Kundenname"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBox x:Name="CustomerNameTextBox"
                     Grid.Column="1"
                     MinHeight="34"
                     FontSize="14"/>
        </Grid>

        <Border Grid.Row="4"
                MinHeight="110"
                Padding="16"
                CornerRadius="8"
                BorderBrush="{DynamicResource GroupBorder}"
                BorderThickness="1"
                Background="{DynamicResource InputBackground}">
            <StackPanel>
                <TextBlock Text="Beispieldateien per Drag &amp; Drop"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Excel + Bestell-PDF + 1–3 Zeichnungs-PDFs"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="6"
                Padding="12"
                CornerRadius="8"
                BorderBrush="{DynamicResource GroupBorder}"
                BorderThickness="1"
                Background="{DynamicResource CardBackground}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Erkannte Struktur"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="FilesSummaryTextBlock"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="AnalysisTextBlock"
                               Foreground="{DynamicResource TextSecondary}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="Noch keine Analyse – Dateien einfügen."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Analysieren"
                    MinWidth="110"
                    Margin="0,0,10,0"
                    Click="Analyze_Click"/>
            <Button Content="Speichern"
                    MinWidth="110"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="Save_Click"/>
            <Button Content="Abbrechen"
                    MinWidth="110"
                    Style="{StaticResource DialogSecondaryButton}"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
