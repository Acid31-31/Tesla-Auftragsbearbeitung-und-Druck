<Window x:Class="PDF_umbenenen.NewCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neuen Kunden anlegen"
        Height="740" Width="920"
        MinHeight="620" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        Closed="Window_Closed">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*" MinHeight="280"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Schrittleiste -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="StepTitleTextBlock"
                       Text="Schritt 1 von 3 – Name &amp; Unterlagen"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="14"/>
            <TextBlock x:Name="StepHintTextBlock"
                       Text="Name eingeben und ankreuzen, was der Kunde schickt. Die KI hilft bei Bedarf rechts."
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,4,0,10"/>
            <UniformGrid Columns="3" Margin="0,0,0,0">
                <Border x:Name="Step1Badge" Padding="8,6" Margin="0,0,6,0" CornerRadius="6"
                        Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="1 · Name" Foreground="White" FontWeight="SemiBold"
                               HorizontalAlignment="Center" FontSize="12"/>
                </Border>
                <Border x:Name="Step2Badge" Padding="8,6" Margin="3,0" CornerRadius="6"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource GroupBorder}" BorderThickness="1">
                    <TextBlock Text="2 · Dateien" Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" FontSize="12"/>
                </Border>
                <Border x:Name="Step3Badge" Padding="8,6" Margin="6,0,0,0" CornerRadius="6"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource GroupBorder}" BorderThickness="1">
                    <TextBlock Text="3 · Prüfen &amp; Speichern" Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" FontSize="12"/>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- Inhalt + KI -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="300" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- Schritt-Inhalte -->
            <Grid Grid.Column="0">
                <!-- Schritt 1 -->
                <StackPanel x:Name="Step1Panel">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Kundenname"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox x:Name="CustomerNameTextBox"
                                 Grid.Column="1"
                                 MinHeight="36"
                                 FontSize="14"/>
                    </Grid>
                    <TextBlock Text="Welche Unterlagen sind vorhanden?"
                               Foreground="{DynamicResource TextPrimary}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <CheckBox x:Name="HasDrawingsCheckBox"
                              Content="Zeichnungen (PDF)"
                              IsChecked="True"
                              Foreground="{DynamicResource TextPrimary}"
                              FontSize="13"
                              Margin="0,0,0,8"/>
                    <CheckBox x:Name="HasExcelCheckBox"
                              Content="Excel-Bestellung"
                              Foreground="{DynamicResource TextPrimary}"
                              FontSize="13"
                              Margin="0,0,0,8"/>
                    <CheckBox x:Name="HasOrderPdfCheckBox"
                              Content="Bestell-PDF (Prüf-PDF)"
                              Foreground="{DynamicResource TextPrimary}"
                              FontSize="13"
                              Margin="0,0,0,8"/>
                    <CheckBox x:Name="HasOrderTextCheckBox"
                              Content="Text-Bestellung (.txt/.csv)"
                              Foreground="{DynamicResource TextPrimary}"
                              FontSize="13"
                              Margin="0,0,0,8"/>
                    <TextBlock Text="Tipp: Excel und Bestell-PDF/Text gleichzeitig möglich – Excel führt dann."
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Schritt 2 -->
                <DockPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top"
                            MinHeight="90"
                            Padding="14"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            Background="{DynamicResource InputBackground}"
                            Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Musterdateien hier ablegen"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="PDF, Excel, Text (.txt/.csv), ZIP – passend zur Auswahl in Schritt 1"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Übernommene Dateien"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,6"/>
                    <Border Padding="10"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource GroupBorder}"
                            BorderThickness="1"
                            Background="{DynamicResource CardBackground}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="FilesSummaryTextBlock"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap"
                                       Text="Noch keine Dateien."/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>

                <!-- Schritt 3 -->
                <DockPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Erneut analysieren"
                                MinWidth="130"
                                Margin="0,0,8,0"
                                Click="Analyze_Click"/>
                        <Button Content="Sortier-Vorschau"
                                MinWidth="130"
                                Click="SortPreview_Click"
                                ToolTip="Zeichnungen mit Wasserzeichen in Bestellreihenfolge"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Erkannte Struktur"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,6"/>
                    <Border Padding="12"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource GroupBorder}"
                            BorderThickness="1"
                            Background="{DynamicResource CardBackground}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="AnalysisTextBlock"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Text="Noch keine Analyse."/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- KI immer sichtbar -->
            <Border Grid.Column="2"
                    Padding="12"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource GroupBorder}"
                    BorderThickness="1"
                    Background="{DynamicResource CardBackground}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               x:Name="ChatPanelTitleTextBlock"
                               Text="KI – Hilfe zu diesem Schritt"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top"
                               x:Name="ChatPanelHintTextBlock"
                               Text="Optional. z. B. «Kunde heißt Müller» oder «Zeichnungen beginnen mit MK-»"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInputTextBox"
                                 MinHeight="34"
                                 VerticalContentAlignment="Center"
                                 KeyDown="ChatInput_KeyDown"
                                 ToolTip="Enter = Senden"/>
                        <Button Grid.Column="1"
                                Content="Senden"
                                MinWidth="80"
                                Margin="8,0,0,0"
                                Click="ChatSend_Click"/>
                    </Grid>
                    <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ChatHistoryTextBlock"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="Die Schritte führen. Die KI nur zum Nachjustieren nutzen."/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Navigation -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Abbrechen"
                    MinWidth="100"
                    HorizontalAlignment="Left"
                    Style="{StaticResource DialogSecondaryButton}"
                    IsCancel="True"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BackButton"
                        Content="Zurück"
                        MinWidth="100"
                        Margin="0,0,8,0"
                        Style="{StaticResource DialogSecondaryButton}"
                        Click="Back_Click"
                        IsEnabled="False"/>
                <Button x:Name="NextButton"
                        Content="Weiter"
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Click="Next_Click"/>
                <Button x:Name="FinishButton"
                        Content="Kunde anlegen"
                        MinWidth="130"
                        Visibility="Collapsed"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
