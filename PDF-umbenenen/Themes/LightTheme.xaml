<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── HELL-Theme ── -->
    <SolidColorBrush x:Key="AppBackground"      Color="#F0F2F5"/>
    <SolidColorBrush x:Key="CardBackground"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBackground"   Color="#1565C0"/>
    <SolidColorBrush x:Key="HeaderForeground"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="#1976D2"/>
    <SolidColorBrush x:Key="AccentHover"        Color="#1565C0"/>
    <SolidColorBrush x:Key="AccentPressed"      Color="#0D47A1"/>
    <SolidColorBrush x:Key="DangerBrush"        Color="#E53935"/>
    <SolidColorBrush x:Key="DangerHover"        Color="#C62828"/>
    <SolidColorBrush x:Key="TextPrimary"        Color="#1A1A2E"/>
    <SolidColorBrush x:Key="TextSecondary"      Color="#555770"/>
    <SolidColorBrush x:Key="TextOnAccent"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBackground"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorder"        Color="#B0BEC5"/>
    <SolidColorBrush x:Key="InputBorderFocus"   Color="#1976D2"/>
    <SolidColorBrush x:Key="GroupBorder"        Color="#CFD8DC"/>
    <SolidColorBrush x:Key="ProgressTrack"      Color="#E3F2FD"/>
    <SolidColorBrush x:Key="ProgressFill"       Color="#1976D2"/>
    <SolidColorBrush x:Key="StatusBackground"   Color="#F8F9FA"/>
    <SolidColorBrush x:Key="StatusBorder"       Color="#CFD8DC"/>
    <SolidColorBrush x:Key="ThemeToggleFG"      Color="#1565C0"/>
    <SolidColorBrush x:Key="SeparatorBrush"     Color="#E0E0E0"/>

</ResourceDictionary>
