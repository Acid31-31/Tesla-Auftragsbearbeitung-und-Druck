<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── DUNKEL-Theme ── -->
    <SolidColorBrush x:Key="AppBackground"      Color="#0F1117"/>
    <SolidColorBrush x:Key="CardBackground"     Color="#1A1D27"/>
    <SolidColorBrush x:Key="HeaderBackground"   Color="#101827"/>
    <SolidColorBrush x:Key="HeaderForeground"   Color="#E8EAF6"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="#5C6BC0"/>
    <SolidColorBrush x:Key="AccentHover"        Color="#7986CB"/>
    <SolidColorBrush x:Key="AccentPressed"      Color="#3949AB"/>
    <SolidColorBrush x:Key="DangerBrush"        Color="#EF5350"/>
    <SolidColorBrush x:Key="DangerHover"        Color="#E53935"/>
    <SolidColorBrush x:Key="SuccessBrush"       Color="#43A047"/>
    <SolidColorBrush x:Key="SuccessHover"      Color="#66BB6A"/>
    <SolidColorBrush x:Key="SuccessPressed"    Color="#2E7D32"/>
    <SolidColorBrush x:Key="WarningBrush"       Color="#FB8C00"/>
    <SolidColorBrush x:Key="WarningHover"       Color="#FFA726"/>
    <SolidColorBrush x:Key="WarningPressed"     Color="#EF6C00"/>
    <SolidColorBrush x:Key="TextPrimary"        Color="#E8EAF6"/>
    <SolidColorBrush x:Key="TextSecondary"      Color="#9FA8DA"/>
    <SolidColorBrush x:Key="TextOnAccent"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBackground"    Color="#252836"/>
    <SolidColorBrush x:Key="InputBorder"        Color="#3D4166"/>
    <SolidColorBrush x:Key="InputBorderFocus"   Color="#7986CB"/>
    <SolidColorBrush x:Key="GroupBorder"        Color="#2E3250"/>
    <SolidColorBrush x:Key="ProgressTrack"      Color="#1A1D2E"/>
    <SolidColorBrush x:Key="ProgressFill"       Color="#39FF14"/>
    <SolidColorBrush x:Key="StatusBackground"   Color="#12141E"/>
    <SolidColorBrush x:Key="StatusBorder"       Color="#2E3250"/>
    <SolidColorBrush x:Key="ThemeToggleFG"      Color="#9FA8DA"/>
    <SolidColorBrush x:Key="SeparatorBrush"     Color="#2E3250"/>

</ResourceDictionary>
