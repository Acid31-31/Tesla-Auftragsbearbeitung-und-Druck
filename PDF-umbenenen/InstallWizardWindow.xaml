<Window x:Class="PDF_umbenenen.InstallWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DOK-V01 Setup"
        Height="620" Width="720"
        MinHeight="560" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="WizardButton" TargetType="Button">
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GroupBorder}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="WizardPrimaryButton" TargetType="Button" BasedOn="{StaticResource WizardButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="WizardTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="WizardCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="WizardSecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="88"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource GroupBorder}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="pack://application:,,,/Assets/AppLogo.png"
                       Width="48" Height="48" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="DOK-V01 Setup" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource HeaderForeground}"/>
                    <TextBlock x:Name="StepTitleTextBlock" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="24,16,24,8" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource GroupBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid>
                <StackPanel x:Name="WelcomePanel" Visibility="Visible">
                    <TextBlock Text="Willkommen beim Installationsassistenten" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22"
                               Text="Dieser Assistent installiert DOK-V01 fest auf Ihrem Computer. Bitte lesen Sie die Lizenz- und Urheberrechtsbedingungen auf der nächsten Seite."/>
                    <TextBlock x:Name="WelcomeVersionTextBlock" Margin="0,16,0,8" FontSize="13" Style="{StaticResource WizardSecondaryText}"/>
                    <TextBlock x:Name="WelcomeCopyrightTextBlock" TextWrapping="Wrap" FontSize="13" Style="{StaticResource WizardSecondaryText}"/>
                </StackPanel>

                <Grid x:Name="LicensePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Lizenz- und Urheberrechtsvereinbarung" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource GroupBorder}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource StatusBackground}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <TextBlock x:Name="LicenseTextBlock" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" LineHeight="18" Foreground="{DynamicResource TextPrimary}"/>
                        </ScrollViewer>
                    </Border>
                    <CheckBox x:Name="AcceptLicenseCheckBox" Grid.Row="2" Margin="0,12,0,0"
                              Style="{StaticResource WizardCheckBox}"
                              Content="Ich habe die Lizenz- und Urheberrechtsbedingungen gelesen und akzeptiere sie."/>
                </Grid>

                <StackPanel x:Name="OptionsPanel" Visibility="Collapsed">
                    <TextBlock Text="Installationsoptionen" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Zielordner:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TargetPathTextBox" Style="{StaticResource WizardTextBox}" IsReadOnly="True" Margin="0,0,0,12"/>
                    <TextBlock Text="Benutzerdaten (PDF-Ablage):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="UserDataPathTextBox" Style="{StaticResource WizardTextBox}" IsReadOnly="True" Margin="0,0,0,16"/>
                    <CheckBox x:Name="InstallCertificateCheckBox" Style="{StaticResource WizardCheckBox}"
                              Content="Herausgeber-Zertifikat installieren (empfohlen für Antivirus-Freigabe)" IsChecked="True"/>
                    <CheckBox x:Name="LaunchAfterInstallCheckBox" Style="{StaticResource WizardCheckBox}"
                              Content="DOK-V01 nach der Installation starten" IsChecked="True"/>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Style="{StaticResource WizardSecondaryText}"
                               Text="Für die Festinstallation ist eine einmalige Windows-Administratorfreigabe (UAC) erforderlich."/>
                </StackPanel>

                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Installation läuft…" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <ProgressBar x:Name="InstallProgressBar" Height="8" IsIndeterminate="True" Margin="40,0"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ProgressTrack}"/>
                    <TextBlock x:Name="ProgressStatusTextBlock" Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource WizardSecondaryText}"/>
                </StackPanel>

                <StackPanel x:Name="FinishPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Installation abgeschlossen" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock x:Name="FinishMessageTextBlock" TextWrapping="Wrap" FontSize="14" LineHeight="22" HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" x:Name="FooterCopyrightTextBlock" Margin="24,0"
                   FontSize="11" Style="{StaticResource WizardSecondaryText}" HorizontalAlignment="Left"/>

        <Border Grid.Row="3" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource GroupBorder}" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel LastChildFill="False">
                <Button x:Name="CancelButton" Content="Abbrechen" Click="CancelButton_Click"
                        Style="{StaticResource WizardButton}" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="Zurück" Click="BackButton_Click"
                            Style="{StaticResource WizardButton}" IsEnabled="False"/>
                    <Button x:Name="NextButton" Content="Weiter" Click="NextButton_Click"
                            Style="{StaticResource WizardPrimaryButton}"/>
                    <Button x:Name="InstallButton" Content="Installieren" Click="InstallButton_Click"
                            Style="{StaticResource WizardPrimaryButton}" Visibility="Collapsed"/>
                    <Button x:Name="CloseButton" Content="Fertigstellen" Click="CloseButton_Click"
                            Style="{StaticResource WizardPrimaryButton}" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
