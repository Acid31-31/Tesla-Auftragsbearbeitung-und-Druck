<Window x:Class="PDF_umbenenen.OrderVerificationReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auftragsprüfung – Bestell-PDF vs Excel"
        Height="560" Width="760"
        MinHeight="420" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SimpleButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource SimpleButton}">
            <Setter Property="Background" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource SimpleButton}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadlineTextBlock"
                   Grid.Row="0"
                   Text="Prüfbericht"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="SourceInfoTextBlock"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="SummaryTextBlock"
                       TextWrapping="Wrap"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource GroupBorder}"
                BorderThickness="1"
                Background="{DynamicResource StatusBackground}"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12">
                <TextBlock x:Name="ReportTextBlock"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="13"
                           LineHeight="20"
                           Foreground="{DynamicResource TextPrimary}"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="AdoptDatesButton"
                    Content="Termine aus Bestell-PDF übernehmen"
                    Click="AdoptDates_Click"
                    Style="{StaticResource SimpleButton}"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"/>
            <Button x:Name="ContinueButton"
                    Content="Trotzdem sortieren"
                    Click="Continue_Click"
                    Style="{StaticResource WarningButton}"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"/>
            <Button x:Name="CloseButton"
                    Content="Schließen"
                    Click="Close_Click"
                    Style="{StaticResource SimpleButton}"/>
            <Button x:Name="CancelButton"
                    Content="Abbrechen"
                    Click="Cancel_Click"
                    Style="{StaticResource CancelButton}"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
