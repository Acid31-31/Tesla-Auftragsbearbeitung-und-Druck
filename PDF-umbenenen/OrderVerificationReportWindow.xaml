<Window x:Class="PDF_umbenenen.OrderVerificationReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PDF_umbenenen.Models"
        Title="Prüf-PDF · Bestellung vs Excel"
        Height="820" Width="1320"
        MinHeight="620" MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="ProtocolHeaderBtn" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButton}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="ProtocolOutlineBtn" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButton}">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ProtocolOpenFileBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProtocolExcelOpenBtn" TargetType="Button" BasedOn="{StaticResource ProtocolOpenFileBtn}">
            <Setter Property="Background" Value="#FF2E7D32"/>
        </Style>

        <Style x:Key="ProtocolPdfOpenBtn" TargetType="Button" BasedOn="{StaticResource ProtocolOpenFileBtn}">
            <Setter Property="Background" Value="#FFE53935"/>
        </Style>

        <Style x:Key="ProtocolPrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProtocolWarningBtn" TargetType="Button" BasedOn="{StaticResource ProtocolPrimaryBtn}">
            <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
        </Style>

        <Style x:Key="Hdr" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>

        <!-- Excel-Gitter: schwarz -->
        <Style x:Key="ExcelGridCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ExcelGridHeaderCell" TargetType="Border" BasedOn="{StaticResource ExcelGridCell}">
            <Setter Property="Background" Value="#FF2E2E2E"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- PDF-Seite: hell wie Papier, schwarze Gitterlinien -->
        <Style x:Key="PdfCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FF212121"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>

        <Style x:Key="PdfHdr" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PdfGridCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="PdfGridHeaderCell" TargetType="Border" BasedOn="{StaticResource PdfGridCell}">
            <Setter Property="Background" Value="#FFE8E8E8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- Einheitliche Fenster-Rahmen -->
        <Style x:Key="ProtocolPane" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style x:Key="ProtocolPaneTitle" TargetType="Border">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Padding" Value="14,12,14,8"/>
            <Setter Property="BorderBrush" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ProtocolColHeaderBar" TargetType="Border">
            <Setter Property="Height" Value="37"/>
            <Setter Property="BorderBrush" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ProtocolDataRow" TargetType="Border">
            <Setter Property="Height" Value="54"/>
            <Setter Property="BorderBrush" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Excel-Zeile -->
        <DataTemplate x:Key="ExcelRowTemplate">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ProtocolDataRow}">
                        <Setter Property="Background" Value="#1A4CAF50"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBgSubDrawing}" Value="True">
                                <Setter Property="Background" Value="#FF1B2838"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAssembly}" Value="True">
                                <Setter Property="Background" Value="#6600FF66"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource ExcelGridCell}" BorderThickness="0,0,1,0">
                        <TextBlock Text="{Binding Position}" Style="{StaticResource Cell}" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ExcelGridCell}" BorderThickness="0,0,1,0">
                        <TextBlock Text="{Binding DrawingNumber}" Style="{StaticResource Cell}"
                                   Cursor="Hand"
                                   ToolTip="Doppelklick: Zeichnungs-PDF öffnen"
                                   MouseLeftButtonDown="DrawingNumber_MouseLeftButtonDown"/>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ExcelGridCell}" BorderThickness="0,0,1,0">
                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Margin="6,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#81C784"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAssembly}" Value="True">
                                            <Setter Property="Foreground" Value="#FF39FF14"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource ExcelGridCell}" BorderThickness="0,0,1,0">
                        <Border Padding="4,2" CornerRadius="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightExcelAmount}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HighlightCellBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ExcelAmount}" Style="{StaticResource Cell}" Margin="0"/>
                        </Border>
                    </Border>
                    <Border Grid.Column="4">
                        <Border Padding="2" CornerRadius="3" Margin="4,8" VerticalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightExcelDate}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HighlightCellBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBox Text="{Binding ExcelDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12"
                                     Padding="4,2"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Termin ändern: Baugruppe → LT-, BG-Einzelteil → FT-, sonst LT-"
                                     KeyDown="ExcelDateBox_KeyDown"
                                     LostFocus="ExcelDateBox_LostFocus"/>
                        </Border>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Abgleich-Zeile: Status über volle Fensterbreite -->
        <DataTemplate x:Key="StatusRowTemplate">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ProtocolDataRow}">
                        <Setter Property="Background" Value="#264CAF50"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBgSubDrawing}" Value="True">
                                <Setter Property="Background" Value="#FF1B2838"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAssembly}" Value="True">
                                <Setter Property="Background" Value="#6600FF66"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="10,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OrderVerificationMatchStatus.Deviation}">
                                        <Setter Property="Background" Value="#33FFC107"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OrderVerificationMatchStatus.MissingInPdf}">
                                        <Setter Property="Background" Value="#33EF5350"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OrderVerificationMatchStatus.MissingInExcel}">
                                        <Setter Property="Background" Value="#33EF5350"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OrderVerificationMatchStatus.Skipped}">
                                        <Setter Property="Background" Value="#332196F3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OrderVerificationMatchStatus.Deviation}">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OrderVerificationMatchStatus.MissingInPdf}">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OrderVerificationMatchStatus.MissingInExcel}">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OrderVerificationMatchStatus.Skipped}">
                                            <Setter Property="Foreground" Value="#64B5F6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} · {1}">
                                    <Binding Path="StatusTitle"/>
                                    <Binding Path="KindLabel"/>
                                </MultiBinding>
                            </TextBlock.Text>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAssembly}" Value="True">
                                            <Setter Property="Foreground" Value="#FF39FF14"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBgSubDrawing}" Value="True">
                                            <Setter Property="Foreground" Value="#FF90CAF9"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding StatusDetail}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- PDF-Zeile: gleiche Struktur wie Excel -->
        <DataTemplate x:Key="PdfRowTemplate">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ProtocolDataRow}">
                        <Setter Property="Background" Value="#FFFFFBF5"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBgSubDrawing}" Value="True">
                                <Setter Property="Background" Value="#FFD0CAC0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAssembly}" Value="True">
                                <Setter Property="Background" Value="#AA76FF03"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PdfGridCell}" BorderThickness="0,0,1,0">
                        <TextBlock Text="{Binding Position}" Style="{StaticResource PdfCell}" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PdfGridCell}" BorderThickness="0,0,1,0">
                        <TextBlock Text="{Binding DrawingNumber}" Style="{StaticResource PdfCell}"
                                   Cursor="Hand"
                                   ToolTip="Doppelklick: Zeichnungs-PDF öffnen"
                                   MouseLeftButtonDown="DrawingNumber_MouseLeftButtonDown"/>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PdfGridCell}" BorderThickness="0,0,1,0">
                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Margin="6,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FF2E7D32"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAssembly}" Value="True">
                                            <Setter Property="Foreground" Value="#FF1B5E20"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource PdfGridCell}" BorderThickness="0,0,1,0">
                        <Border Padding="4,2" CornerRadius="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightPdfAmount}" Value="True">
                                            <Setter Property="Background" Value="#FFFFECB3"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding PdfAmount}" Style="{StaticResource PdfCell}" Margin="0"/>
                        </Border>
                    </Border>
                    <Border Grid.Column="4">
                        <Grid Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="4,2" CornerRadius="3" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HighlightPdfDate}" Value="True">
                                                <Setter Property="Background" Value="#FFFFECB3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding PdfDate}" Style="{StaticResource PdfCell}" Margin="0"/>
                            </Border>
                            <Button Grid.Column="1" Content="←"
                                    Width="28" Height="26" Padding="0"
                                    HorizontalAlignment="Right"
                                    FontSize="14" FontWeight="Bold"
                                    Foreground="#FF212121"
                                    ToolTip="PDF-Termin nach links übernehmen (Baugruppe → LT-, BG-Einzelteil → FT-)"
                                    Click="CopyPdfDate_Click"
                                    Style="{StaticResource DialogSecondaryButton}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource GroupBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Image Source="pack://application:,,,/Assets/AppLogo.png" Height="44" Stretch="Uniform"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Prüf-PDF · Bestellung vs Excel" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Abgleich Excel-Steuerdatei mit Bestell-PDF" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="⚙  Einstellungen" Style="{StaticResource ProtocolHeaderBtn}" Margin="0,0,8,0" Click="Settings_Click"/>
                    <Button Content="ℹ  Info" Style="{StaticResource ProtocolHeaderBtn}" Click="Info_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Drei Spaltenfenster: schwarze Trennung dazwischen, oben und unten -->
        <Grid Grid.Row="1" Margin="16,0,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF000000"/>

            <Border Grid.Row="1" Background="#FF000000" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

            <!-- Excel-Fenster -->
            <Border Grid.Column="0"
                    Style="{StaticResource ProtocolPane}"
                    Background="{DynamicResource CardBackground}"
                    SizeChanged="ProtocolPane_SizeChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="37"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource ProtocolPaneTitle}" Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0">
                                <TextBlock Text="X" Foreground="{DynamicResource ExcelAccentBrush}" FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ExcelFileTextBlock" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Tabelle: Bestellung" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource ProtocolColHeaderBar}" Background="#FF2E2E2E">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ExcelGridHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="Pos." Style="{StaticResource Hdr}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource ExcelGridHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="Zeichnungsnummer" Style="{StaticResource Hdr}" Margin="6,0" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource ExcelGridHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="Bezeichnung" Style="{StaticResource Hdr}" Margin="6,0" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource ExcelGridHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="Menge" Style="{StaticResource Hdr}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="4">
                                <TextBlock Text="Liefertermin" Style="{StaticResource Hdr}" Margin="6,0" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="ExcelRowsScroll"
                                  Grid.Row="2"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="PaneScroll_ScrollChanged">
                        <ItemsControl x:Name="ExcelRowsItemsControl" ItemTemplate="{StaticResource ExcelRowTemplate}"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Abgleich-Fenster -->
            <Border Grid.Column="2"
                    Style="{StaticResource ProtocolPane}"
                    Background="{DynamicResource CardBackground}"
                    SizeChanged="ProtocolPane_SizeChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="37"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource ProtocolPaneTitle}" Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#33FFC107" CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0">
                                <TextBlock Text="↔" Foreground="{DynamicResource WarningBrush}" FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Abgleich-Ergebnis" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Excel ↔ Bestell-PDF" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource ProtocolColHeaderBar}" Background="#FF2E2E2E">
                        <TextBlock Text="Status" Style="{StaticResource Hdr}" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Border>
                    <ScrollViewer x:Name="StatusRowsScroll"
                                  Grid.Row="2"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="PaneScroll_ScrollChanged">
                        <ItemsControl x:Name="StatusRowsItemsControl" ItemTemplate="{StaticResource StatusRowTemplate}"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- PDF-Fenster (heller Grund bleibt, Ecken wie die anderen Fenster) -->
            <Border Grid.Column="4"
                    Style="{StaticResource ProtocolPane}"
                    Background="#FFFFFBF5"
                    SizeChanged="ProtocolPane_SizeChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="37"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource ProtocolPaneTitle}" Background="#FFF5F5F5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#FFEF5350" CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0">
                                <TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PdfFileTextBlock" FontSize="13" FontWeight="SemiBold" Foreground="#FF212121"/>
                                <TextBlock x:Name="PdfMetaTextBlock" FontSize="11" Foreground="#FF616161"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource ProtocolColHeaderBar}" Background="#FFE8E8E8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PdfGridHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="Pos." Style="{StaticResource PdfHdr}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PdfGridHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="Zeichnungsnummer" Style="{StaticResource PdfHdr}" Margin="6,0" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PdfGridHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="Bezeichnung" Style="{StaticResource PdfHdr}" Margin="6,0" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource PdfGridHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="Menge" Style="{StaticResource PdfHdr}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="4">
                                <TextBlock Text="Liefertermin" Style="{StaticResource PdfHdr}" Margin="6,0" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="PdfRowsScroll"
                                  Grid.Row="2"
                                  Background="Transparent"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="PaneScroll_ScrollChanged">
                        <ItemsControl x:Name="PdfRowsItemsControl" ItemTemplate="{StaticResource PdfRowTemplate}"/>
                    </ScrollViewer>
                </Grid>
            </Border>

                </Grid>
            </Border>

            <!-- Schwarze Trennung unter den Fenstern (wie oben) -->
            <Border Grid.Row="2" Background="#FF000000"/>

            <Grid Grid.Row="3" Background="{DynamicResource MainContentBackground}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0"
                        Content="📂  Excel öffnen"
                        Style="{StaticResource ProtocolExcelOpenBtn}"
                        Click="LoadExcel_Click"/>

                <Button Grid.Row="0" Grid.Column="4"
                        Content="📄  PDF öffnen"
                        Style="{StaticResource ProtocolPdfOpenBtn}"
                        Click="LoadPdf_Click"/>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#FF1B2838" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                            <TextBlock Text="Dunkel = BG-Einzelteil (FT)" FontSize="10" Foreground="#B0BEC5" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#264CAF50" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                            <TextBlock Text="Grün = Einzelteil (LT)" FontSize="10" Foreground="#81C784" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#6600FF66" CornerRadius="4" Padding="8,4">
                            <TextBlock Text="Neongrün = Baugruppe (LT)" FontSize="10" Foreground="#FF39FF14" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <Border Style="{StaticResource StatusPill}" BorderBrush="{DynamicResource SuccessBrush}">
                        <TextBlock x:Name="MatchCountTextBlock" Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Border Style="{StaticResource StatusPill}" BorderBrush="{DynamicResource WarningBrush}">
                        <TextBlock x:Name="DeviationCountTextBlock" Foreground="{DynamicResource WarningBrush}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Border Style="{StaticResource StatusPill}" BorderBrush="{DynamicResource DangerBrush}" Margin="0,0,0,10">
                        <TextBlock x:Name="ErrorCountTextBlock" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Button x:Name="CompleteButton" Content="✓  Prüfung abgeschlossen" Style="{StaticResource ProtocolPrimaryBtn}" IsEnabled="True" Click="Complete_Click"
                            ToolTip="Excel-Termine (links) für die Sortierung übernehmen und weiter"/>
                    <Button x:Name="AdoptDatesButton" Content="Nur PDF → Excel kopieren" Style="{StaticResource ProtocolOutlineBtn}" Click="AdoptDates_Click" Visibility="Collapsed"
                            ToolTip="Optional: abweichende Termine aus der Bestell-PDF nach links kopieren"/>
                    <Button x:Name="ContinueButton" Content="Trotzdem übernehmen" Style="{StaticResource ProtocolOutlineBtn}" Click="Continue_Click" Visibility="Collapsed"/>
                    <Button x:Name="CancelButton" Content="Abbrechen" Style="{StaticResource ProtocolOutlineBtn}" Click="Cancel_Click" Visibility="Collapsed"/>
                    <Button x:Name="CloseButton" Content="Schließen" Style="{StaticResource ProtocolOutlineBtn}" Margin="0" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource FooterBackground}"
                BorderBrush="{DynamicResource GroupBorder}"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock x:Name="FooterVersionTextBlock" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Content="📤  Bericht exportieren"
                        Style="{StaticResource ProtocolHeaderBtn}"
                        Click="ExportReport_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
